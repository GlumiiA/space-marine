<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="025-create-import-file-table" author="Aigul">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="import_file"/>
            </not>
        </preConditions>

        <createTable tableName="import_file">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="import_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="tx_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_username" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="file_name" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="bucket" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="object_key" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="storage_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="import_file"
                                 baseColumnNames="import_id"
                                 constraintName="fk_importfile_imports"
                                 referencedTableName="imports"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_import_file_import_id" tableName="import_file">
            <column name="import_id"/>
        </createIndex>
        <createIndex indexName="idx_import_file_owner" tableName="import_file">
            <column name="owner_username"/>
        </createIndex>
        <createIndex indexName="idx_import_file_txid" tableName="import_file">
            <column name="tx_id"/>
        </createIndex>

        <rollback>
            <dropForeignKeyConstraint baseTableName="import_file" constraintName="fk_importfile_imports"/>
            <dropTable tableName="import_file"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
